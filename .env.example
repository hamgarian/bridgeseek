# BridgeSeek configuration
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# DEEPSEEK_WEB_TOKEN: the bearer token your browser sends to
#   chat.deepseek.com. Grab it from DevTools -> Network -> any
#   api request -> Authorization header (strip the "Bearer " prefix).
DEEPSEEK_WEB_TOKEN=

# DEEPSEEK_COOKIES: the full Cookie header from an authenticated
#   chat.deepseek.com request, as a single line. Include the
#   session and Cloudflare device cookies.
DEEPSEEK_COOKIES="__cf_logged_in=1; ds_session_id={INSERT_HERE}; smidV2={INSERT_HERE}; CF_VERIFIED_DEVICE_{INPUT_UUID}={INSERT_HERE}"

# DEEPSEEK_DEVICE_ID (Optional): The device ID associated with your browser session.
#   If not provided, a random UUID will be generated to prevent fingerprinting.
#   Only set this if you want to strictly match the device ID of your real browser.
# DEEPSEEK_DEVICE_ID="fdaae6a4-f675-46ab-9c59-e49b35168cbc"

# BRIDGE_ACCOUNTS (Optional): JSON string mapping custom API keys to specific accounts.
#   When a client provides an API key in the Authorization header (e.g. Bearer my-key-1),
#   the bridge will use the corresponding token and cookies for that request. If the key 
#   is not found or BRIDGE_ACCOUNTS is not set, it falls back to the global DEEPSEEK_WEB_TOKEN.
# BRIDGE_ACCOUNTS='{"my-key-1": {"token": "xxx", "cookies": "yyy"}, "my-key-2": {"token": "aaa", "cookies": "bbb"}}'


# ── Optional bridge settings (defaults shown) ──────────────────────
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8123
# BRIDGE_IMPERSONATE=chrome131
# BRIDGE_SESSION_TTL_S=2592000
# BRIDGE_FILE_TTL_S=2592000
# BRIDGE_MAX_FILE_BYTES=209715200
# BRIDGE_IDLE_CLIENT_TTL_S=21600
# BRIDGE_EMIT_REASONING=1
# BRIDGE_EMIT_TOOLS=0
# BRIDGE_USE_USER_AS_SESSION=0
# Use the stable Claude/system context so recaps and "continue" retain the
# same upstream chat. Use first-user for multi-client deployments unless each
# caller supplies x-session-id, x-conversation-id, or metadata.session_id.
# BRIDGE_SESSION_KEY_MODE=system
# Reuse one DeepSeek chat and send incremental tool results by default.
# Set to 1 only to force every tool turn into a new upstream chat.
# BRIDGE_TOOL_FRESH_SESSION=0
# BRIDGE_LOG_RAW_TOOL_OUTPUT=0
# BRIDGE_RATE_LIMIT_COOLDOWN_S=15
# BRIDGE_OUTPUT_CHUNK_CHARS=512
# BRIDGE_MIN_REQUEST_GAP_S=1.5
# BRIDGE_MAX_TOOL_ATTEMPTS=3
# BRIDGE_MAX_SESSION_RECREATIONS=2
# BRIDGE_MAX_FLATTENED_CHARS=60000
# BRIDGE_MAX_INCREMENTAL_CHARS=24000
# BRIDGE_TOOL_DESC_MAX=200
# BRIDGE_TOOL_PARAM_DESC_MAX=100
# BRIDGE_TOOL_ALLOWLIST=Bash,Read,Write,Edit,Glob,Grep,LS,TodoRead,TodoWrite,MultiEdit
